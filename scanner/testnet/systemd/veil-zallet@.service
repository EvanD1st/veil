[Unit]
Description=VEIL isolated experimental Zallet TESTNET %i
After=network-online.target veil-zebra.service
Wants=network-online.target veil-zebra.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
LogNamespace=veil-testnet
User=veil-testnet
Group=veil-testnet
EnvironmentFile=/etc/veil-testnet/paths.env
EnvironmentFile=/var/lib/veil-testnet/service.env
Environment=PATH=/opt/veil-testnet/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/opt/veil-testnet/node/bin/node /opt/veil-testnet/app/scanner/testnet/wait-node.mjs
ExecStart=/opt/veil-testnet/current/bin/zallet -d ${VEIL_LAB_ROOT}/%i start
Restart=on-failure
RestartSec=30
TimeoutStartSec=240
TimeoutStopSec=180
KillSignal=SIGINT
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=1G
CPUQuota=100%
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/veil-testnet
LogRateLimitIntervalSec=60
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
