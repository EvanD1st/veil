[Unit]
Description=VEIL platform demo seller reveal worker (TESTNET only)
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=2

[Service]
User=veil-demo
Group=veil-demo
WorkingDirectory=/opt/veil-demo-worker
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/veil-demo-worker/browsers
ExecStart=/opt/veil-testnet/node/bin/node --max-old-space-size=256 judging/run.mjs worker /etc/veil-demo/private.json
Restart=on-failure
RestartSec=60
TimeoutStopSec=45
MemoryHigh=1200M
MemoryMax=1536M
MemorySwapMax=128M
CPUQuota=50%
TasksMax=160
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/veil-demo
UMask=0077

[Install]
WantedBy=multi-user.target
