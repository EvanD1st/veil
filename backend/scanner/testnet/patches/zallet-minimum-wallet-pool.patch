+//! Reserve database connections for RPC in addition to the four long-lived sync tasks.
+
+pub(super) fn wallet_pool_config() -> deadpool::managed::PoolConfig {
+    let mut config = deadpool::managed::PoolConfig::default();
+    // The CPU-derived default can be only two or four on small or CPU-limited hosts.
+    // Sync owns four connections for its lifetime; leave room for RPC and keystore work.
+    config.max_size = config.max_size.max(8);
+    config
+}
+
+#[cfg(test)]
+mod tests {
+    use deadpool::managed::{Manager, Metrics, Pool, RecycleResult};
+    use std::{convert::Infallible, time::Duration};
+
+    struct DummyManager;
+    impl Manager for DummyManager {
+        type Type = ();
+        type Error = Infallible;
+        async fn create(&self) -> Result<(), Infallible> {
+            Ok(())
+        }
+        async fn recycle(&self, _: &mut (), _: &Metrics) -> RecycleResult<Infallible> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn four_sync_connections_leave_a_connection_for_rpc() {
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(async {
+                let pool: Pool<DummyManager> = Pool::builder(DummyManager)
+                    .config(super::wallet_pool_config())
+                    .build()
+                    .unwrap();
+                let mut held = Vec::new();
+                // Hold all four sync connections while acquiring the separate RPC connection.
+                for _ in 0..5 {
+                    held.push(
+                        tokio::time::timeout(Duration::from_secs(1), pool.get())
+                            .await
+                            .expect("database pool exhausted by background sync tasks")
+                            .unwrap(),
+                    );
+                }
+            });
+    }
+}
